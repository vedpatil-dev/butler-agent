# Copy to .env (never commit it). All optional; defaults shown.
AGENT_LLM_URL=http://127.0.0.1:11434   # user-level iGPU instance: http://127.0.0.1:11435
AGENT_MODEL=qwen3.5:9b
AGENT_NUM_CTX=65536
AGENT_THINK=false          # false = no hidden reasoning tokens (faster); true/default = let Qwen think
AGENT_MAX_STEPS=20
AGENT_PORT=8000
AGENT_WORKSPACE=~/Projects # API server only; butler/agent CLI always uses the directory it is started in
# AGENT_NUM_GPU=0          # 0 = force CPU
# AGENT_STATE_DIR=~/.local/state/local-agent   # where conversations/history/logs live (use a temp dir for tests)
